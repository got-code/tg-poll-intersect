    "test:browser": "node test/browser.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm build && pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "@mtcute/web": "0.32.8",
    "qr": "0.7.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.62.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
